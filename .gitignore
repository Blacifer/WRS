# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production build outputs
dist/
client/dist/
server/dist/

# SQLite databases, journals & caches
*.db
*.db-shm
*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
# Photographs are files beside the database — evidence, never in git
server/data/photos/
# One line per server start, beside the database
server/data/starts.log

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and agent artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.agents/
.DS_Store
*.log

# Editor directories
.vscode/
.idea/
backups/

# Locally generated TLS material for LAN testing — never commit
server/certs/
dist-shop/

# scripts/screen-walk.mjs output — screenshots of every screen, for a person to read
screen-walk/
# Local demo database, logs and photographs (server/data/demo/) — never committed
server/data/demo/
server/data/backup.key
demo-rehearsal/
docs/manuals/*.txt
docs/artifacts/
