# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

# Generate with: openssl rand -hex 32
#
# SET THIS ONCE, BEFORE THE FIRST REAL WAGON, AND THEN DO NOT CHANGE IT.
# It is not only the session signing key. It also derives the key that
# encrypts every enrolled authenticator secret, and the key that signs every
# release certificate. Changing it therefore:
#   - logs everyone out                        (harmless, they log back in)
#   - invalidates pending one-time codes       (harmless, they last 5 minutes)
#   - breaks EVERY enrolled authenticator      (every supervisor must re-enrol)
#   - makes EVERY issued certificate unverifiable
# That last one matters most: a certificate is the proof a named supervisor
# released a named wagon. If the key that signed it is gone, that proof cannot
# be recomputed, which is exactly when you would want it.
# Back it up separately from the database — losing it is as bad as rotating it.
JWT_SECRET=

# How long a login session stays valid.
JWT_EXPIRES_IN=24h

# Set to the exact origin the tablets load the app from. With NODE_ENV=production
# and this left as *, the server prints a warning and STARTS ANYWAY — it does not
# refuse. The app and API are served from one origin, so the tablets never need a
# CORS grant; the wildcard is accepted risk on a closed LAN and should be pinned
# before any deployment reachable from outside the workshop.
CORS_ORIGIN=*

# How a supervisor receives their one-time code for release sign-off.
#   INLINE — the code is returned in the API response (default).
#            An audited two-step confirmation, but NOT a second factor:
#            whoever requests the code receives it. Acceptable for a LAN
#            pilot on supervisor-owned tablets; state it explicitly if the
#            deployment is reviewed.
#   SMS    — not implemented. Requires an SMS gateway integration; the
#            server refuses to start if you select it.
OTP_DELIVERY=INLINE

# Off-site copy of the encrypted backups (any S3-compatible storage). The key
# never leaves the machine; the bucket only ever holds ciphertext. All four
# are required for the copy to run; without them the USB disk is the off-site copy.
# WRS_CLOUD_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# WRS_CLOUD_BUCKET=wrs-raipur-backups
# WRS_CLOUD_ACCESS_KEY=
# WRS_CLOUD_SECRET_KEY=
# WRS_CLOUD_REGION=ap-south-1
# WRS_CLOUD_PREFIX=raipur/
